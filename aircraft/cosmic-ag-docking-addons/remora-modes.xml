<?xml version="1.0" encoding="UTF-8"?>
<!-- Remora formation-mode hardware and effects (Cosmic Ag docking demo).
     Included by remora-drone-v2-port.xml / -starboard.xml. Driven by
     Nasal/cosmic_modes.nas through properties on the AI drone:
       cosmic/spray     spray mist from the wing spray bar and the pod nozzle
       cosmic/scouting  scout: the gimbal under the nose sweeps (cosmic/scan-deg)
       cosmic/blink     scout light
     Hidden with the drone while it is docked (cosmic/hidden).
     Geometry: remora-modes.ac from gen_formation_addons.py. -->
<PropertyList>
  <path>remora-modes.ac</path>
  <animation>
    <type>select</type>
    <object-name>scout_gimbal_stalk</object-name>
    <object-name>scout_gimbal</object-name>
    <object-name>scout_light</object-name>
    <object-name>spray_bar</object-name>
    <condition><not><property>cosmic/hidden</property></not></condition>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>scout_gimbal</object-name>
    <property>cosmic/scan-deg</property>
    <factor>1</factor>
    <center><x-m>-0.1206</x-m><y-m>0</y-m><z-m>-0.2010</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>select</type>
    <object-name>scout_light</object-name>
    <condition><property>cosmic/blink</property></condition>
  </animation>
  <particlesystem>
    <name>spray_left</name>
    <texture>Effects/spray.png</texture>
    <emissive>false</emissive>
    <lighting>false</lighting>
    <offsets><x-m>0.1162</x-m><y-m>-0.3000</y-m><z-m>-0.1366</z-m></offsets>
    <condition>
      <and>
        <property>cosmic/spray</property>
        <not><property>cosmic/hidden</property></not>
      </and>
    </condition>
    <align>billboard</align>
    <attach>world</attach>
    <placer><type>point</type></placer>
    <shooter>
      <!-- down and aft: theta from straight up, phi 0 = aft (+x) -->
      <theta-min-deg>140</theta-min-deg>
      <theta-max-deg>175</theta-max-deg>
      <phi-min-deg>-25</phi-min-deg>
      <phi-max-deg>25</phi-max-deg>
      <speed-mps><value>3</value><spread>1.5</spread></speed-mps>
      <rotation-speed>
        <x-min-deg-sec>-20</x-min-deg-sec><x-max-deg-sec>20</x-max-deg-sec>
        <y-min-deg-sec>-20</y-min-deg-sec><y-max-deg-sec>20</y-max-deg-sec>
        <z-min-deg-sec>-20</z-min-deg-sec><z-max-deg-sec>20</z-max-deg-sec>
      </rotation-speed>
    </shooter>
    <counter><particles-per-sec><value>45</value><spread>10</spread></particles-per-sec></counter>
    <particle>
      <start>
        <color>
          <red><value>0.92</value></red><green><value>0.95</value></green>
          <blue><value>0.97</value></blue><alpha><value>0.45</value></alpha>
        </color>
        <size><value>0.12</value></size>
      </start>
      <end>
        <color>
          <red><value>0.85</value></red><green><value>0.90</value></green>
          <blue><value>0.92</value></blue><alpha><value>0.0</value></alpha>
        </color>
        <size><value>1.6</value></size>
      </end>
      <life-sec><value>2.2</value></life-sec>
      <mass-kg>0.0005</mass-kg>
      <radius-m>0.02</radius-m>
    </particle>
    <program>
      <fluid>air</fluid>
      <gravity>true</gravity>
      <wind>true</wind>
    </program>
  </particlesystem>
  <particlesystem>
    <name>spray_right</name>
    <texture>Effects/spray.png</texture>
    <emissive>false</emissive>
    <lighting>false</lighting>
    <offsets><x-m>0.1162</x-m><y-m>0.3000</y-m><z-m>-0.1366</z-m></offsets>
    <condition>
      <and>
        <property>cosmic/spray</property>
