<?xml version="1.0"?>
<!-- Seminole T-tail parts (Cosmic Industries fleet round 2026-11-26), in SenecaII.ac coordinates. -->
<PropertyList>
	<path>seminole-ttail.ac</path>

	<animation>
		<type>rotate</type>
		<object-name>SeminoleStabilator</object-name>
		<property>surface-positions/elevator-pos-norm</property>
		<factor>14</factor>
		<center><x-m>3.515</x-m><y-m>0</y-m><z-m>2.53</z-m></center>
		<axis><x>0</x><y>1</y><z>0</z></axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>SeminoleRudder</object-name>
		<property>surface-positions/rudder-pos-norm</property>
		<factor>27</factor>
		<axis>
			<x1-m>3.62</x1-m><y1-m>0</y1-m><z1-m>1.47</z1-m>
			<x2-m>3.80</x2-m><y2-m>0</y2-m><z2-m>2.45</z2-m>
		</axis>
	</animation>
</PropertyList>
