<?xml version="1.0"?>
<!-- American Champion 7GCAA Citabria (rough). Cosmic Industries fleet round 2026-11-26. Rough model generated by gen_fleet.py. -->
<PropertyList>
	<path>Cosmic-Citabria.ac</path>

	<animation>
		<type>select</type>
		<object-name>PropBlades</object-name>
		<condition><less-than><property>engines/engine[0]/rpm</property><value>500</value></less-than></condition>
	</animation>
	<animation>
		<type>select</type>
		<object-name>PropDisc</object-name>
		<condition><greater-than-equals><property>engines/engine[0]/rpm</property><value>500</value></greater-than-equals></condition>
	</animation>
	<animation>
		<type>spin</type>
		<object-name>PropBlades</object-name>
		<object-name>Spinner</object-name>
		<property>engines/engine[0]/rpm</property>
		<factor>1</factor>
		<center><x-m>0.12</x-m><y-m>0</y-m><z-m>0</z-m></center>
		<axis><x>-1</x><y>0</y><z>0</z></axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>LeftAileron</object-name>
		<property>surface-positions/left-aileron-pos-norm</property>
		<factor>20</factor>
		<axis><x1-m>2.626</x1-m><y1-m>0</y1-m><z1-m>0.860</z1-m><x2-m>2.626</x2-m><y2-m>-5</y2-m><z2-m>0.947</z2-m></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>RightAileron</object-name>
		<property>surface-positions/right-aileron-pos-norm</property>
		<factor>-20</factor>
		<axis><x1-m>2.626</x1-m><y1-m>0</y1-m><z1-m>0.860</z1-m><x2-m>2.626</x2-m><y2-m>5</y2-m><z2-m>0.947</z2-m></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Elevator</object-name>
		<property>surface-positions/elevator-pos-norm</property>
		<factor>25</factor>
		<center><x-m>6.306</x-m><y-m>0</y-m><z-m>0.220</z-m></center>
		<axis><x>0</x><y>1</y><z>0</z></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Rudder</object-name>
		<property>surface-positions/rudder-pos-norm</property>
		<factor>25</factor>
		<axis><x1-m>6.380</x1-m><y1-m>0</y1-m><z1-m>0.300</z1-m><x2-m>6.550</x2-m><y2-m>0</y2-m><z2-m>1.500</z2-m></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Stick</object-name>
		<property>controls/flight/elevator</property>
		<factor>15</factor>
		<center><x-m>1.880</x-m><y-m>0</y-m><z-m>-0.400</z-m></center>
		<axis><x>0</x><y>1</y><z>0</z></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Stick</object-name>
		<property>controls/flight/aileron</property>
		<factor>15</factor>
		<center><x-m>1.880</x-m><y-m>0</y-m><z-m>-0.400</z-m></center>
		<axis><x>1</x><y>0</y><z>0</z></axis>
	</animation>
	<animation>
		<type>translate</type>
		<object-name>ThrottleLever</object-name>
		<property>controls/engines/engine[0]/throttle</property>
		<factor>-0.08</factor>
		<axis><x>1</x><y>0</y><z>0</z></axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>TailWheel</object-name>
		<property>surface-positions/rudder-pos-norm</property>
		<factor>-20</factor>
		<center><x-m>6.380</x-m><y-m>0</y-m><z-m>0</z-m></center>
		<axis><x>0</x><y>0</y><z>1</z></axis>
	</animation>

	<model>
		<path>Aircraft/Instruments-3d/asi/asi.xml</path>
