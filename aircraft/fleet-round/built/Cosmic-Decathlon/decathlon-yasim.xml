<?xml version="1.0"?>
<!-- American Champion 8KCAB Decathlon (rough): YASim flight model (surface x/y/z are YASim mid-chord root points), Cosmic Industries fleet round 2026-11-26.
     Solved by YASim from published figures: approach 60 kt at 7.0 deg AoA, cruise 123 kt at 6000 ft.
     Empty 1340 lb, gross 1950 lb. Model x aft = YASim -x. -->
<airplane mass="1340" version="YASIM_VERSION_CURRENT">

  <approach speed="60" aoa="7.0" fuel="0.3">
    <control-setting axis="/controls/engines/engine[0]/throttle" value="0.25"/>
    <control-setting axis="/controls/engines/engine[0]/mixture" value="1"/>
    <control-setting axis="/controls/engines/engine[0]/condition" value="1"/>
    <control-setting axis="/controls/engines/engine[0]/propeller-pitch" value="1"/>
    <control-setting axis="/controls/flight/flaps" value="0.00"/>
    <solve-weight idx="0" weight="170"/>
  </approach>

  <cruise speed="123" alt="6000" fuel="0.5">
    <control-setting axis="/controls/engines/engine[0]/throttle" value="1.00"/>
    <control-setting axis="/controls/engines/engine[0]/mixture" value="1"/>
    <control-setting axis="/controls/engines/engine[0]/condition" value="1"/>
    <control-setting axis="/controls/engines/engine[0]/propeller-pitch" value="0.9"/>
    <control-setting axis="/controls/flight/flaps" value="0"/>
    <solve-weight idx="0" weight="170"/>
  </cruise>

  <cockpit x="-2.200" y="-0.000" z="0.620"/>

  <fuselage ax="-0.300" ay="0" az="0.000" bx="-6.550" by="0" bz="0.220" width="0.78" taper="0.35" midpoint="0.3"/>

  <wing x="-2.302" y="0.000" z="0.860" length="4.900" chord="1.603" sweep="0" dihedral="1.0" camber="0.030" incidence="1.5" twist="-1.5" taper="1.00" idrag="1.00">
    <stall aoa="15" width="4" peak="1.5"/>
    <flap1 start="0.50" end="0.97" lift="1.3" drag="1.1"/>
    <control-input axis="/controls/flight/flaps" control="FLAP0"/>
    <control-input axis="/controls/flight/aileron" control="FLAP1" split="true"/>
    <control-input axis="/controls/flight/aileron-trim" control="FLAP1" split="true"/>
    <control-output control="FLAP0" prop="/surface-positions/flap-pos-norm"/>
    <control-output control="FLAP1" side="left" prop="/surface-positions/left-aileron-pos-norm"/>
    <control-output control="FLAP1" side="right" prop="/surface-positions/right-aileron-pos-norm"/>
    <control-speed control="FLAP0" transition-time="6"/>
  </wing>

  <hstab x="-6.325" y="0.000" z="0.220" length="1.620" chord="0.950" sweep="0" taper="0.76" incidence="0">
    <stall aoa="16" width="4" peak="1.5"/>
    <flap0 start="0" end="1" lift="1.9" drag="1.2"/>
    <control-input axis="/controls/flight/elevator" control="FLAP0"/>
    <control-input axis="/controls/flight/elevator-trim" control="FLAP0"/>
    <control-output control="FLAP0" prop="/surface-positions/elevator-pos-norm"/>
  </hstab>

  <vstab x="-6.150" y="0.000" z="0.300" length="1.250" chord="1.400" sweep="28.2" taper="0.57">
    <stall aoa="16" width="4" peak="1.5"/>
    <flap0 start="0" end="1" lift="1.4" drag="1.2"/>
    <control-input axis="/controls/flight/rudder" control="FLAP0" invert="true"/>
    <control-input axis="/controls/flight/rudder-trim" control="FLAP0" invert="true"/>
    <control-output control="FLAP0" prop="/surface-positions/rudder-pos-norm" min="1" max="-1"/>
  </vstab>

  <propeller x="-0.600" y="0.000" z="0.000" mass="380" moment="7.4" radius="0.940" cruise-speed="110" cruise-rpm="2500" cruise-alt="6000"
             cruise-power="135" takeoff-power="180" takeoff-rpm="2700" min-rpm="1800" max-rpm="2700">
    <actionpt x="-0.120" y="0.000" z="0.000"/>
    <piston-engine eng-power="180" eng-rpm="2700" displacement="361" compression="8.7">
      <control-input axis="/controls/engines/engine[0]/magnetos" control="MAGNETOS"/>
      <control-input axis="/controls/engines/engine[0]/throttle" control="THROTTLE"/>
      <control-input axis="/controls/engines/engine[0]/starter" control="STARTER"/>
      <control-input axis="/controls/engines/engine[0]/mixture" control="MIXTURE"/>
    </piston-engine>
    <control-input axis="/controls/engines/engine[0]/propeller-pitch" control="ADVANCE"/>
  </propeller>

  <!-- main gear (spring steel legs) and steerable tailwheel; tail sits on its wheel at 12.5 deg -->
  <gear x="-1.300" y="0.920" z="-1.190" compression="0.12" spring="0.9" damp="1.2">
    <control-input axis="/controls/gear/brake-left" control="BRAKE"/>
    <control-input axis="/controls/gear/brake-parking" control="BRAKE"/>
  </gear>
  <gear x="-1.300" y="-0.920" z="-1.190" compression="0.12" spring="0.9" damp="1.2">
    <control-input axis="/controls/gear/brake-right" control="BRAKE"/>
    <control-input axis="/controls/gear/brake-parking" control="BRAKE"/>
  </gear>
  <gear x="-6.450" y="0.000" z="-0.048" compression="0.06" spring="0.6" damp="1.5" sfric="0.8" dfric="0.6">
    <control-input axis="/controls/flight/rudder" control="STEER" square="true" src0="-1" src1="1" dst0="-0.45" dst1="0.45"/>
  </gear>

  <tank x="-2.141" y="1.470" z="0.860" capacity="120"/>
  <tank x="-2.141" y="-1.470" z="0.860" capacity="120"/>

  <weight x="-2.300" y="0.000" z="-0.050" mass-prop="/sim/weight[0]/weight-lb"/>
  <weight x="-3.050" y="0.000" z="-0.050" mass-prop="/sim/weight[1]/weight-lb"/>
  <!-- nose ballast: engine and firewall-forward mass, tuned with the YASim solver to put the CG near 25-28% MAC -->
  <ballast x="-0.500" y="0.000" z="0.000" mass="302"/>
</airplane>
