#!/usr/bin/env bash
set -euo pipefail
FG_ROOT="${FG_ROOT:-$HOME/.fgfs/fgdata_2024_1}"
FG_HOME="${FG_HOME:-$HOME/.fgfs}"
MAPDIR="$FG_ROOT/Input/Joysticks/Saitek"
EVENTDIR="$FG_HOME/Input/Event/Saitek"

show_menu() {
  if command -v whiptail >/dev/null 2>&1; then
    whiptail --title "FlightGear MGA — Controller Setup" --menu \
      "Detected devices: Saitek Cyborg Evo Force and SAITEK CYBORG 3D USB.\nChoose a task:" 18 78 8 \
      status "Show device nodes and mapping inventory" \
      evo "Inspect Cyborg Evo Force mapping" \
      gold "Inspect Cyborg 3D / Gold mapping" \
      event "Test live controller axes/buttons (evtest)" \
      folder "Open user Event profile folder" \
      native "Open FlightGear input device configuration instructions" \
      quit "Exit" 3>&1 1>&2 2>&3
  else
    printf '%s\n' "1) Status  2) Evo mapping  3) Gold mapping  4) evtest  5) profile folder  6) instructions  0) Exit"
    read -r -p "Choose: " x
    case "$x" in
      1) echo status;; 2) echo evo;; 3) echo gold;; 4) echo event;; 5) echo folder;; 6) echo native;; *) echo quit;;
    esac
  fi
}

while true; do
  choice="$(show_menu)" || exit 0
  case "$choice" in
    status)
      echo "Kernel: $(uname -r)"
      echo
      echo "Input nodes:"
      for f in /sys/class/input/event*/device/name; do
        [[ -r "$f" ]] || continue
        n="$(cat "$f" 2>/dev/null || true)"
        case "$n" in *Saitek*|*SAITEK*|*Cyborg*|*CYBORG*) printf '%s: %s\n' "$f" "$n";; esac
      done
      echo
      echo "Joystick nodes:"
      ls -l /dev/input/js* 2>/dev/null || echo "No /dev/input/js* nodes. FlightGear Linux Event input may still work."
      echo
      echo "Bundled mappings:"
      find "$MAPDIR" -maxdepth 1 -type f -iname '*cyborg*.xml' -print 2>/dev/null | sort
      echo
      echo "User Event profiles:"
      find "$EVENTDIR" -maxdepth 2 -type f -print 2>/dev/null | sort || true
      read -r -p "Press Enter to return..."
      ;;
    evo)
      f="$MAPDIR/Cyborg-Evo.xml"
      if [[ -f "$f" ]]; then
        if command -v xdg-open >/dev/null 2>&1; then xdg-open "$f" >/dev/null 2>&1 || true; else sed -n '1,240p' "$f"; fi
      else echo "Mapping not found: $f"; fi
      read -r -p "Press Enter to return..." || true
      ;;
    gold)
      f="$MAPDIR/Cyborg-Gold-3d-USB.xml"
      if [[ -f "$f" ]]; then
        if command -v xdg-open >/dev/null 2>&1; then xdg-open "$f" >/dev/null 2>&1 || true; else sed -n '1,240p' "$f"; fi
      else echo "Mapping not found: $f"; fi
      read -r -p "Press Enter to return..." || true
      ;;
    event)
      if ! command -v evtest >/dev/null 2>&1; then echo "evtest is not installed. Install it with: sudo apt install evtest"; read -r -p "Press Enter..."; continue; fi
      mapfile -t devs < <(for f in /sys/class/input/event*/device/name; do
        [[ -r "$f" ]] || continue
        n="$(cat "$f" 2>/dev/null || true)"
        case "$n" in *Saitek*|*SAITEK*|*Cyborg*|*CYBORG*) printf '/dev/input/%s|%s\n' "$(basename "$(dirname "$(dirname "$f")")")" "$n";; esac
      done)
      if [[ ${#devs[@]} -eq 0 ]]; then echo "No Saitek event devices found."; read -r -p "Press Enter..."; continue; fi
      echo "Available event devices:"
      for i in "${!devs[@]}"; do echo "$i) ${devs[$i]}"; done
      read -r -p "Device number: " n
      if [[ "$n" =~ ^[0-9]+$ ]] && (( n < ${#devs[@]} )); then
        dev="${devs[$n]%%|*}"
        echo "Testing $dev; Ctrl+C to stop."
        sudo evtest "$dev" || evtest "$dev" || true
      fi
      ;;
    folder)
      mkdir -p "$EVENTDIR"
      if command -v xdg-open >/dev/null 2>&1; then xdg-open "$EVENTDIR" >/dev/null 2>&1 || true; else echo "$EVENTDIR"; fi
      ;;
    native)
      cat <<'HELP'
Native FlightGear setup:
1. Start FlightGear and open its Input Devices dialog.
2. Select each Linux Event device individually.
3. Check its axis/button events and assign elevator, aileron, rudder, throttle, brakes as appropriate.
4. Save a user profile under ~/.fgfs/Input/Event/Saitek.
5. Test parked at low power before flight. Do not assume axis direction is correct.
The user-space setup here does not configure force feedback and does not modify kernel modules.
HELP
      read -r -p "Press Enter to return..."
      ;;
    quit|*) exit 0;;
  esac
done
