<!-- mga-checklist: in-flight checklist tied to each cockpit control (fgfs-mga, GPL-2.0-or-later) -->
<PropertyList>
    <meta>
        <file-type type="string">FlightGear add-on metadata</file-type>
        <format-version type="int">1</format-version>
    </meta>
    <addon>
        <identifier type="string">org.cosmicindustries.mga-checklist</identifier>
        <name type="string">MGA checklist</name>
        <version type="string">1.0.0</version>
        <authors>
            <author>
                <name type="string">Cosmic Industries LLC</name>
            </author>
