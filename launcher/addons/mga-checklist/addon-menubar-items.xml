<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <meta>
        <file-type type="string">FlightGear add-on menu bar items</file-type>
        <format-version type="int">1</format-version>
    </meta>
    <menubar-items>
        <menu>
            <label>Checklist</label>
            <enabled type="bool">true</enabled>
            <item>
                <label>Show / hide (Ctrl-K)</label>
                <binding><command>nasal</command><script>mgaChecklist.toggle();</script></binding>
            </item>
            <item>
                <label>Next checklist</label>
                <binding><command>nasal</command><script>mgaChecklist.step(1);</script></binding>
            </item>
            <item>
                <label>Previous checklist</label>
                <binding><command>nasal</command><script>mgaChecklist.step(-1);</script></binding>
            </item>
            <item>
                <label>Clear my ticks</label>
                <binding><command>nasal</command><script>mgaChecklist.clearTicks();</script></binding>
            </item>
        </menu>
    </menubar-items>
</PropertyList>
