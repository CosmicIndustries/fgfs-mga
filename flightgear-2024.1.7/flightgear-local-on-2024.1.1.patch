+void LauncherController::requestLocationWeather(QString station, double latitude, double longitude)
+{
+    station = station.trimmed().toUpper();
+    qInfo() << "[MGA Weather] request for" << station << "lat" << latitude << "lon" << longitude;
+    static const QRegularExpression stationPattern(QStringLiteral("^[A-Z0-9]{3,4}$"));
+    if (!stationPattern.match(station).hasMatch()) {
+        emit locationWeatherUpdated(station, QString(), QString(), tr("Selected location has no usable airport identifier."));
+        emit locationSatelliteUpdated(station, QString(), QString(), QString(), tr("Selected location has no coordinates."));
+        return;
+    }
+
+    QNetworkAccessManager* manager = findChild<QNetworkAccessManager*>(QStringLiteral("mgaLocationContextNetwork"));
+    if (!manager) {
+        manager = new QNetworkAccessManager(this);
+        manager->setObjectName(QStringLiteral("mgaLocationContextNetwork"));
+    }
+
+    // Aviation Weather Center's public API does not enable browser CORS; issue
+    // requests from Qt's native network stack instead of QML XMLHttpRequest.
+    QUrl metarUrl(QStringLiteral("https://aviationweather.gov/api/data/metar"));
+    QUrlQuery metarQuery;
+    metarQuery.addQueryItem(QStringLiteral("ids"), station);
+    metarQuery.addQueryItem(QStringLiteral("format"), QStringLiteral("json"));
+    metarQuery.addQueryItem(QStringLiteral("hours"), QStringLiteral("3"));
+    metarUrl.setQuery(metarQuery);
+
+    QNetworkRequest metarRequest(metarUrl);
+    metarRequest.setRawHeader("User-Agent", "FlightGearLauncher/1.0 (https://www.flightgear.org)");
+    metarRequest.setRawHeader("Accept", "application/json");
+    QNetworkReply* metarReply = manager->get(metarRequest);
+    connect(metarReply, &QNetworkReply::finished, this, [this, metarReply, station]() {
+        const QByteArray body = metarReply->readAll();
+        const int status = metarReply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        const auto networkError = metarReply->error();
+        const QString networkErrorText = metarReply->errorString();
+        metarReply->deleteLater();
+
+        if (networkError != QNetworkReply::NoError || status >= 400) {
+            qWarning() << "[MGA Weather] METAR failure" << station << "HTTP" << status << networkErrorText;
+            emit locationWeatherUpdated(station, QString(), QString(),
+                tr("Weather service request failed (%1). %2").arg(status).arg(networkErrorText));
+            return;
+        }
+
+        QJsonParseError parseError;
+        const QJsonDocument document = QJsonDocument::fromJson(body, &parseError);
+        if (parseError.error != QJsonParseError::NoError || !document.isArray() || document.array().isEmpty()) {
+            emit locationWeatherUpdated(station, QString(), QString(), tr("No current METAR observation is available for %1.").arg(station));
+            return;
+        }
+
+        const QJsonObject metar = document.array().first().toObject();
+        auto field = [&metar](const QString& key) -> QString {
+            const QJsonValue value = metar.value(key);
+            if (value.isString()) return value.toString();
+            if (value.isDouble()) return QString::number(value.toDouble(), 'g', 6);
+            if (value.isBool()) return value.toBool() ? QStringLiteral("true") : QStringLiteral("false");
+            return QString();
+        };
+
+        QStringList parts;
+        const QString category = field(QStringLiteral("fltCat"));
+        if (!category.isEmpty()) parts << tr("Flight category: %1").arg(category);
+
+        const QString windDirection = field(QStringLiteral("wdir"));
+        const QString windSpeed = field(QStringLiteral("wspd"));
+        const QString windGust = field(QStringLiteral("wgst"));
+        if (!windSpeed.isEmpty()) {
+            QString wind = tr("Wind %1 at %2 kt").arg(windDirection.isEmpty() ? QStringLiteral("—") : windDirection,
+                                                        windSpeed);
+            if (!windGust.isEmpty() && windGust != QStringLiteral("0")) wind += tr(" gusting %1 kt").arg(windGust);
+            parts << wind;
+        }
+
+        const QString visibility = field(QStringLiteral("visib"));
+        if (!visibility.isEmpty()) parts << tr("Visibility %1 SM").arg(visibility);
+        const QString altimeter = field(QStringLiteral("altim"));
+        if (!altimeter.isEmpty()) parts << tr("Altimeter %1 inHg").arg(altimeter);
+        const QString temperature = field(QStringLiteral("temp"));
+        const QString dewpoint = field(QStringLiteral("dewp"));
+        if (!temperature.isEmpty()) {
+            QString temp = tr("Temperature %1 °C").arg(temperature);
+            if (!dewpoint.isEmpty()) temp += tr(" / dew point %1 °C").arg(dewpoint);
+            parts << temp;
+        }
+
+        QStringList cloudLayers;
+        const QJsonValue cloudsValue = metar.value(QStringLiteral("clouds"));
+        if (cloudsValue.isArray()) {
+            for (const QJsonValue& cloudValue : cloudsValue.toArray()) {
+                const QJsonObject cloud = cloudValue.toObject();
+                QString layer = cloud.value(QStringLiteral("cover")).toString();
+                const QJsonValue base = cloud.value(QStringLiteral("base"));
+                if (base.isDouble()) layer += tr(" %1 ft").arg(base.toInt());
+                if (!layer.isEmpty()) cloudLayers << layer;
+            }
+        }
+        if (!cloudLayers.isEmpty()) parts << tr("Clouds: %1").arg(cloudLayers.join(QStringLiteral(", ")));
+
+        const QString raw = field(QStringLiteral("rawOb"));
+        const QString summary = parts.isEmpty() ? tr("Latest METAR received for %1.").arg(station)
+                                                : parts.join(QStringLiteral("  |  "));
+        qInfo() << "[MGA Weather] METAR success" << station << "raw=" << raw;
+        emit locationWeatherUpdated(station, summary, raw, QString());
+    });
+
+    const bool validCoordinates = latitude >= -90.0 && latitude <= 90.0 &&
+                                  longitude >= -180.0 && longitude <= 180.0;
+    if (!validCoordinates) {
+        emit locationSatelliteUpdated(station, QString(), QString(), QString(), tr("Airport coordinates are invalid."));
+        return;
+    }
+
+    // Pull the image through Qt's network stack and cache it locally. This avoids
+    // relying on QML's remote-image loader and guarantees the preview is actually fetched.
+    auto pullSatellite = [this, manager, station](const QString& imageUrl,
+                                                  const QString& loopUrl,
+                                                  const QString& region) {
+        if (imageUrl.isEmpty()) {
+            emit locationSatelliteUpdated(station, QString(), loopUrl, region, tr("No satellite image URL was found."));
+            return;
+        }
+        QNetworkRequest imageRequest{QUrl(imageUrl)};
+        imageRequest.setRawHeader("User-Agent", "FlightGearLauncher/1.0 (https://www.flightgear.org)");
+        imageRequest.setRawHeader("Accept", "image/jpeg,image/*;q=0.9,*/*;q=0.5");
+        QNetworkReply* imageReply = manager->get(imageRequest);
+        connect(imageReply, &QNetworkReply::finished, this,
+                [this, imageReply, station, imageUrl, loopUrl, region]() {
+            const QByteArray bytes = imageReply->readAll();
+            const int status = imageReply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const auto networkError = imageReply->error();
+            const QString networkErrorText = imageReply->errorString();
+            imageReply->deleteLater();
+
+            if (networkError != QNetworkReply::NoError || status >= 400) {
+                qWarning().noquote() << "[MGA Satellite] image failure" << station << "HTTP" << status << networkErrorText << imageUrl;
+                emit locationSatelliteUpdated(station, QString(), loopUrl, region,
+                    tr("Satellite download failed (%1): %2").arg(status).arg(networkErrorText));
+                return;
+            }
+            QImage decoded;
+            if (bytes.isEmpty() || !decoded.loadFromData(bytes)) {
+                emit locationSatelliteUpdated(station, QString(), loopUrl, region,
+                    tr("Satellite service returned data that is not a usable image."));
+                return;
+            }
+
+            QString cacheRoot = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+            if (cacheRoot.isEmpty()) cacheRoot = QDir::homePath() + QStringLiteral("/.cache/flightgear-launcher");
+            cacheRoot += QStringLiteral("/satellite");
+            if (!QDir().mkpath(cacheRoot)) {
+                emit locationSatelliteUpdated(station, QString(), loopUrl, region,
+                    tr("Could not create the satellite image cache directory."));
+                return;
+            }
+            const QString cachePath = cacheRoot + QLatin1Char('/') + station.toLower() + QStringLiteral("-regional.jpg");
+            QSaveFile file(cachePath);
+            if (!file.open(QIODevice::WriteOnly) || file.write(bytes) != bytes.size() || !file.commit()) {
+                const QString fileError = file.errorString();
+                file.cancelWriting();
+                emit locationSatelliteUpdated(station, QString(), loopUrl, region,
+                    tr("Could not save the downloaded satellite image: %1").arg(fileError));
+                return;
+            }
+            qInfo().noquote() << "[MGA Satellite] cached" << cachePath << "bytes=" << bytes.size() << "url=" << imageUrl;
+            emit locationSatelliteUpdated(station, QUrl::fromLocalFile(cachePath).toString(), loopUrl, region, QString());
+        });
+    };
+
+    auto pullDiskSatellite = [this, manager, station](const QString& satellite) {
+        const QString imageUrl = QStringLiteral("https://cdn.star.nesdis.noaa.gov/%1/ABI/FD/GEOCOLOR/678x678.jpg").arg(satellite);
+        QNetworkRequest imageRequest{QUrl(imageUrl)};
+        imageRequest.setRawHeader("User-Agent", "FlightGearLauncher/1.0 (https://www.flightgear.org)");
+        imageRequest.setRawHeader("Accept", "image/jpeg,image/*;q=0.9,*/*;q=0.5");
+        QNetworkReply* imageReply = manager->get(imageRequest);
+        connect(imageReply, &QNetworkReply::finished, this,
+                [this, imageReply, station, satellite]() {
+            const QByteArray bytes = imageReply->readAll();
+            const int status = imageReply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const auto networkError = imageReply->error();
+            const QString networkErrorText = imageReply->errorString();
+            imageReply->deleteLater();
+
+            if (networkError != QNetworkReply::NoError || status >= 400) {
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("Download failed (%1): %2").arg(status).arg(networkErrorText));
+                return;
+            }
+            QImage decoded;
+            if (bytes.isEmpty() || !decoded.loadFromData(bytes)) {
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("NOAA returned data that is not a usable image."));
+                return;
+            }
+
+            QString cacheRoot = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+            if (cacheRoot.isEmpty()) cacheRoot = QDir::homePath() + QStringLiteral("/.cache/flightgear-launcher");
+            cacheRoot += QStringLiteral("/satellite");
+            if (!QDir().mkpath(cacheRoot)) {
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("Could not create the satellite image cache directory."));
+                return;
+            }
+            const QString cachePath = cacheRoot + QLatin1Char('/') + station.toLower()
+                + QLatin1Char('-') + satellite.toLower() + QStringLiteral("-fulldisk.jpg");
+            QSaveFile file(cachePath);
+            if (!file.open(QIODevice::WriteOnly)) {
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("Could not open cache file: %1").arg(file.errorString()));
+                return;
+            }
+            if (file.write(bytes) != bytes.size()) {
+                const QString fileError = file.errorString();
+                file.cancelWriting();
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("Could not write cache file: %1").arg(fileError));
+                return;
+            }
+            if (!file.commit()) {
+                emit locationDiskSatelliteUpdated(station, satellite, QString(),
+                    tr("Could not commit cache file: %1").arg(file.errorString()));
+                return;
+            }
+            emit locationDiskSatelliteUpdated(station, satellite,
+                QUrl::fromLocalFile(cachePath).toString(), QString());
+        });
+    };
+
+    // Pull both global views through Qt and cache them locally. The regional
+    // image below is selected from the airport's coordinates.
+    pullDiskSatellite(QStringLiteral("GOES19"));
+    pullDiskSatellite(QStringLiteral("GOES18"));
+
+    // Dedicated sectors produce genuinely regional satellite views for Alaska,
+    // Hawaii and Puerto Rico; mainland airports use the matching NOAA WFO imagery.
+    if (latitude >= 50.0 && longitude < -130.0) {
+        pullSatellite(QStringLiteral("https://cdn.star.nesdis.noaa.gov/GOES18/ABI/SECTOR/ak/GEOCOLOR/latest.jpg"),
+                      QStringLiteral("https://www.goes.noaa.gov/sector_band.php?band=GEOCOLOR&length=24&sat=G18&sector=ak"),
+                      tr("Alaska · GOES-18"));
+        return;
+    }
+    if (latitude >= 18.0 && latitude <= 23.5 && longitude >= -162.0 && longitude <= -154.0) {
+        pullSatellite(QStringLiteral("https://cdn.star.nesdis.noaa.gov/GOES18/ABI/SECTOR/hi/GEOCOLOR/latest.jpg"),
+                      QStringLiteral("https://www.goes.noaa.gov/sector_band.php?band=GEOCOLOR&length=24&sat=G18&sector=hi"),
+                      tr("Hawaii · GOES-18"));
+        return;
+    }
+    if (latitude >= 17.0 && latitude <= 20.5 && longitude >= -70.5 && longitude <= -63.0) {
+        pullSatellite(QStringLiteral("https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/pr/GEOCOLOR/latest.jpg"),
+                      QStringLiteral("https://www.goes.noaa.gov/sector_band.php?band=GEOCOLOR&length=24&sat=G19&sector=pr"),
+                      tr("Puerto Rico · GOES-19"));
+        return;
+    }
+
+    const QUrl pointsUrl(QStringLiteral("https://api.weather.gov/points/%1,%2")
+        .arg(QString::number(latitude, 'f', 4), QString::number(longitude, 'f', 4)));
+    QNetworkRequest pointsRequest(pointsUrl);
+    pointsRequest.setRawHeader("User-Agent", "FlightGearLauncher/1.0 (https://www.flightgear.org)");
+    pointsRequest.setRawHeader("Accept", "application/geo+json");
+    QNetworkReply* pointsReply = manager->get(pointsRequest);
+    connect(pointsReply, &QNetworkReply::finished, this,
+            [this, pointsReply, station, longitude, pullSatellite]() {
+        const QByteArray body = pointsReply->readAll();
+        const int status = pointsReply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        const auto networkError = pointsReply->error();
+        pointsReply->deleteLater();
+
+        QString imageUrl;
+        QString loopUrl;
+        QString region;
+        if (networkError == QNetworkReply::NoError && status < 400) {
+            const QJsonDocument document = QJsonDocument::fromJson(body);
+            const QString office = document.object().value(QStringLiteral("properties")).toObject()
+                .value(QStringLiteral("cwa")).toString().trimmed().toLower();
+            if (!office.isEmpty()) {
+                const QString satellite = longitude < -105.0 ? QStringLiteral("GOES18") : QStringLiteral("GOES19");
+                const QString satelliteCode = longitude < -105.0 ? QStringLiteral("GOES-18") : QStringLiteral("GOES-19");
+                imageUrl = QStringLiteral("https://cdn.star.nesdis.noaa.gov/WFO/%1/GEOCOLOR/latest.jpg").arg(office);
+                loopUrl = QStringLiteral("https://cdn.star.nesdis.noaa.gov/WFO/%1/GEOCOLOR/%2-%3-GEOCOLOR-600x600.gif")
+                    .arg(office, satellite, office.toUpper());
+                region = tr("WFO %1 · %2 regional imagery").arg(office.toUpper(), satelliteCode);
+            }
+        }
+        if (imageUrl.isEmpty()) {
+            const QString satellite = longitude < -105.0 ? QStringLiteral("GOES18") : QStringLiteral("GOES19");
+            const QString satCode = longitude < -105.0 ? QStringLiteral("G18") : QStringLiteral("G19");
+            imageUrl = QStringLiteral("https://cdn.star.nesdis.noaa.gov/%1/ABI/FD/GEOCOLOR/678x678.jpg").arg(satellite);
+            loopUrl = QStringLiteral("https://www.goes.noaa.gov/sector_band.php?band=GEOCOLOR&length=24&sat=%1&sector=fd").arg(satCode);
+            region = longitude < -105.0 ? tr("GOES-18 full disk") : tr("GOES-19 full disk");
+        }
+        pullSatellite(imageUrl, loopUrl, region);
+    });
+}
