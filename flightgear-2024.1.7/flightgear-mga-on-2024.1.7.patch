+void LauncherController::runControlsTool(QString what)
+{
+    if (what != QStringLiteral("check") && what != QStringLiteral("show")) {
+        emit controlsToolFinished(what, false, QStringLiteral("Unknown request."));
+        return;
+    }
+    const QString exe = mgaLauncherPath();
+    if (exe.isEmpty()) {
+        emit controlsToolFinished(what, false, tr("fgfs-mga isn't installed in ~/.local/bin."));
+        return;
+    }
+    auto* p = new QProcess(this);
+    p->setProcessChannelMode(QProcess::MergedChannels);
+    p->setProcessEnvironment(mgaToolEnvironment());
+    connect(p, &QProcess::errorOccurred, this, [this, p, what](QProcess::ProcessError err) {
+        if (err != QProcess::FailedToStart)
+            return;
+        emit controlsToolFinished(what, false, tr("Couldn't start fgfs-mga."));
+        p->deleteLater();
+    });
+    connect(p, &QProcess::finished, this, [this, p, what](int code, QProcess::ExitStatus status) {
+        QString text = QString::fromUtf8(p->readAll()).trimmed();
+        p->deleteLater();
+        const bool ok = (status == QProcess::NormalExit) && (code == 0);
+        if (what == QStringLiteral("check") && ok && text.isEmpty())
+            text = tr("Ready: the sticks are plugged in and the main controls are bound.");
+        emit controlsToolFinished(what, ok, text);
+    });
+    p->start(exe, {QStringLiteral("controls"), what});
+}
