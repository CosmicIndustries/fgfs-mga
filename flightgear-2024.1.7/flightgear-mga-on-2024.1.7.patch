+QString LauncherController::selectedAircraftId() const
+{
+    if (!m_selectedAircraft.isLocalFile())
+        return {};
+    QString name = QFileInfo(m_selectedAircraft.toLocalFile()).fileName();
+    if (!name.endsWith(QStringLiteral("-set.xml")))
+        return {};
+    name.chop(8);
+    return name;
+}
