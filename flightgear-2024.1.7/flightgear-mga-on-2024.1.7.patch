+void LauncherController::requestFaaCharts(QString ident)
+{
+    ident = ident.trimmed().toUpper();
+    static const QRegularExpression identPattern(QStringLiteral("^[A-Z0-9]{3,4}$"));
+    if (!identPattern.match(ident).hasMatch()) {
+        emit faaChartsReady(ident, QString(), tr("no airport selected"));
+        return;
+    }
+    // d-TPP charts follow the 28-day AIRAC cycle (YYNN). Worked out locally from the 2401 cycle
+    // (effective 25 Jan 2024), because faa.gov refuses requests that don't come from a browser.
+    const QDate epoch(2024, 1, 25);
+    const QDate today = QDate::currentDate();
+    const qint64 n = epoch.daysTo(today) / 28;
+    const QDate effective = epoch.addDays(n * 28);
+    qint64 k = n;
+    while (k > 0 && epoch.addDays((k - 1) * 28).year() == effective.year()) --k;
+    const int number = int(n - k) + 1;
+    const QString cycle = QStringLiteral("%1%2").arg(effective.year() % 100, 2, 10, QLatin1Char('0'))
+                                                .arg(number, 2, 10, QLatin1Char('0'));
+    emit faaChartsReady(ident,
+        QStringLiteral("https://www.faa.gov/air_traffic/flight_info/aeronav/digital_products/dtpp/search/results/?cycle=%1&ident=%2")
+            .arg(cycle, ident), QString());
+}
