+QVariantMap LauncherController::selectedAirportContext() const
+{
+    QVariantMap result;
+    result.insert(QStringLiteral("valid"), false);
+
+    if (!m_location) {
+        qInfo() << "[MGA Weather] no LocationController";
+        return result;
+    }
+
+    QmlPositioned* base = m_location->baseLocation();
+    if (!base || !base->valid()) {
+        qInfo() << "[MGA Weather] no valid selected base location";
+        return result;
+    }
+
+    const FGPositionedRef positioned = base->inner();
+    if (!positioned || !FGPositioned::isAirportType(positioned.ptr())) {
+        qInfo() << "[MGA Weather] selected base is not an airport";
+        return result;
+    }
+
+    const SGGeod geod = positioned->geod();
+    if (!geod.isValid()) {
+        qInfo() << "[MGA Weather] selected airport has invalid coordinates:" << QString::fromStdString(positioned->ident());
+        return result;
+    }
+
+    result.insert(QStringLiteral("valid"), true);
+    result.insert(QStringLiteral("ident"), QString::fromStdString(positioned->ident()));
+    result.insert(QStringLiteral("name"), QString::fromStdString(positioned->name()));
+    result.insert(QStringLiteral("latitudeDeg"), geod.getLatitudeDeg());
+    result.insert(QStringLiteral("longitudeDeg"), geod.getLongitudeDeg());
+    return result;
+}
