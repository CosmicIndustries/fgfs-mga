+// ---------------------------------------------------------------------------------------------
+// MGA: Controls page (fgfs-mga controls). The window itself is fgfs-mga's own Qt controls tool;
+// the launcher only starts it beside itself and shows `fgfs-mga controls check|show`.
+
+static QString mgaLauncherPath()
+{
+    const QString own = QDir::homePath() + QStringLiteral("/.local/bin/fgfs-mga");
+    if (QFileInfo(own).isExecutable())
+        return own;
+    return QStandardPaths::findExecutable(QStringLiteral("fgfs-mga"));
+}
+
+// The tools are Python + PyQt5; don't hand them this process's Qt 6 / library search paths.
+static QProcessEnvironment mgaToolEnvironment()
+{
+    QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    for (const char* name : {"LD_LIBRARY_PATH", "QT_PLUGIN_PATH", "QML2_IMPORT_PATH", "QML_IMPORT_PATH",
+                             "QT_QPA_PLATFORM_PLUGIN_PATH", "QT_QUICK_CONTROLS_STYLE"}) {
+        env.remove(QString::fromLatin1(name));
+    }
+    return env;
+}
