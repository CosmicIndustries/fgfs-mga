+void LauncherController::requestMapTile(QString layer, int z, int x, int y)
+{
+    const QString key = QStringLiteral("%1/%2/%3/%4").arg(layer).arg(z).arg(x).arg(y);
+    const int n = 1 << qBound(0, z, 19);
+    if (z < 1 || z > 18 || x < 0 || y < 0 || x >= n || y >= n) {
+        emit mapTileReady(key, QUrl(), tr("tile out of range"));
+        return;
+    }
+    QString url;
+    if (layer == QStringLiteral("street"))
+        url = QStringLiteral("https://tile.openstreetmap.org/%1/%2/%3.png").arg(z).arg(x).arg(y);
+    else if (layer == QStringLiteral("topo"))
+        url = QStringLiteral("https://tile.opentopomap.org/%1/%2/%3.png").arg(z).arg(x).arg(y);
+    else if (layer == QStringLiteral("satellite"))
+        url = QStringLiteral("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/%1/%2/%3").arg(z).arg(y).arg(x);
+    else if (layer == QStringLiteral("sectional"))
+        url = QStringLiteral("https://tiles.arcgis.com/tiles/ssFJjBXIUyZDrSYZ/arcgis/rest/services/VFR_Sectional/MapServer/tile/%1/%2/%3").arg(z).arg(y).arg(x);
+    else {
+        emit mapTileReady(key, QUrl(), tr("unknown map view"));
+        return;
+    }
+
+    const QString path = QDir::homePath() + QStringLiteral("/.cache/fgfs-mga/tiles/") + key + QStringLiteral(".img");
+    const QFileInfo cached(path);
+    // OSM tile policy: keep tiles at least 7 days before asking again
+    if (cached.exists() && cached.size() > 0 && cached.lastModified().daysTo(QDateTime::currentDateTime()) < 14) {
+        emit mapTileReady(key, QUrl::fromLocalFile(path), QString());
+        return;
+    }
+
+    QNetworkAccessManager* manager = findChild<QNetworkAccessManager*>(QStringLiteral("mgaMapTileNetwork"));
+    if (!manager) {
+        manager = new QNetworkAccessManager(this);
+        manager->setObjectName(QStringLiteral("mgaMapTileNetwork"));
+    }
+    QNetworkRequest req{QUrl(url)};
+    req.setRawHeader("User-Agent", "FlightGearLauncher/2024.1 (https://www.flightgear.org)");
+    req.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+    QNetworkReply* reply = manager->get(req);
+    connect(reply, &QNetworkReply::finished, this, [this, reply, key, path]() {
+        const QByteArray body = reply->readAll();
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        const bool failed = reply->error() != QNetworkReply::NoError || status >= 400 || body.isEmpty();
+        const QString err = reply->errorString();
+        reply->deleteLater();
+        if (failed) {
+            if (QFileInfo::exists(path)) {   // stale is better than nothing
+                emit mapTileReady(key, QUrl::fromLocalFile(path), QString());
+            } else {
+                emit mapTileReady(key, QUrl(), tr("map tile unavailable (%1) %2").arg(status).arg(err));
+            }
+            return;
+        }
+        QDir().mkpath(QFileInfo(path).absolutePath());
+        QSaveFile out(path);
+        if (out.open(QIODevice::WriteOnly)) {
+            out.write(body);
+            out.commit();
+        }
+        emit mapTileReady(key, QUrl::fromLocalFile(path), QString());
+    });
+}
+
