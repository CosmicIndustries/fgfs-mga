+bool LauncherController::openControlsWindow()
+{
+    const QString exe = mgaLauncherPath();
+    if (exe.isEmpty())
+        return false;
+    QStringList args{QStringLiteral("controls"), QStringLiteral("gui")};
+    const QString id = selectedAircraftId();
+    if (!id.isEmpty())
+        args << QStringLiteral("--aircraft") << id;
+    QProcess p;
+    p.setProgram(exe);
+    p.setArguments(args);
+    p.setProcessEnvironment(mgaToolEnvironment());
+    p.setStandardInputFile(QProcess::nullDevice());
+    // detached: the window stays open when Fly! closes the launcher window
+    return p.startDetached();
