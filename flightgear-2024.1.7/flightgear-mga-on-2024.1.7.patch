+// MGA: pre-flight hub helpers (Summary page) and Location overlay extras.
+
+static QString mgaSetupDir()
+{
+    return QDir::homePath() + QStringLiteral("/.config/fgfs-mga/setups");
+}
+
+static QString mgaSetupFile(const QString& name)
+{
+    QString safe = name.trimmed();
+    safe.replace(QRegularExpression(QStringLiteral("[^A-Za-z0-9 _.,()+-]")), QStringLiteral("_"));
+    if (safe.isEmpty() || safe.startsWith(QLatin1Char('.'))) return {};
+    return mgaSetupDir() + QLatin1Char('/') + safe.left(60) + QStringLiteral(".fglaunch");
+}
+
+QStringList LauncherController::mgaSetupNames() const
+{
+    QStringList names;
+    const QFileInfoList files = QDir(mgaSetupDir()).entryInfoList({QStringLiteral("*.fglaunch")}, QDir::Files, QDir::Name);
+    for (const QFileInfo& f : files) names << f.completeBaseName();
+    return names;
+}
+
+bool LauncherController::mgaSaveSetup(QString name)
+{
+    const QString path = mgaSetupFile(name);
+    if (path.isEmpty()) return false;
+    QDir().mkpath(mgaSetupDir());
+    return m_config->saveConfigToFile(path);
+}
+
+bool LauncherController::mgaLoadSetup(QString name)
+{
+    const QString path = mgaSetupFile(name);
+    if (path.isEmpty() || !QFileInfo::exists(path)) return false;
+    return m_config->loadConfigFromFile(path);
+}
+
+bool LauncherController::mgaDeleteSetup(QString name)
+{
+    const QString path = mgaSetupFile(name);
+    if (path.isEmpty() || !QFileInfo::exists(path)) return false;
+    // keep a copy instead of deleting outright
+    const QString trash = mgaSetupDir() + QStringLiteral("/.removed");
+    QDir().mkpath(trash);
+    return QFile::rename(path, trash + QLatin1Char('/') + QFileInfo(path).fileName() + QLatin1Char('.')
+                                   + QString::number(QDateTime::currentSecsSinceEpoch()));
+}
