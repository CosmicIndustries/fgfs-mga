+QVariantMap LauncherController::sceneryStatus() const
+{
+    QVariantMap r;
+    const QVariantMap f = airportFieldInfo();
+    if (!f.value(QStringLiteral("valid")).toBool()) return r;
+    const SGBucket b(SGGeod::fromDeg(f.value(QStringLiteral("longitudeDeg")).toDouble(),
+                                     f.value(QStringLiteral("latitudeDeg")).toDouble()));
+    const QString tile = QString::fromStdString(b.gen_base_path());
+    const QString index = QString::number(b.gen_index());
+    const QString home = QDir::homePath() + QStringLiteral("/.fgfs/");
+    QStringList roots = {home + QStringLiteral("TerraSync"), home + QStringLiteral("Scenery-Addons")};
+    const QStringList envScenery = QString::fromLocal8Bit(qgetenv("FG_SCENERY")).split(QLatin1Char(':'), Qt::SkipEmptyParts);
+    roots << envScenery;
+    auto has = [&](const QString& kind, const QStringList& exts) {
+        for (const QString& root : roots) {
+            for (const QString& ext : exts) {
+                if (QFileInfo::exists(root + QLatin1Char('/') + kind + QLatin1Char('/') + tile + QLatin1Char('/') + index + ext))
+                    return true;
+            }
+        }
+        return false;
+    };
+    r.insert(QStringLiteral("tile"), tile + QLatin1Char('/') + index);
+    r.insert(QStringLiteral("terrain"), has(QStringLiteral("Terrain"), {QStringLiteral(".stg"), QStringLiteral(".btg.gz")}));
+    r.insert(QStringLiteral("objects"), has(QStringLiteral("Objects"), {QStringLiteral(".stg")}));
+    r.insert(QStringLiteral("buildings"), has(QStringLiteral("Buildings"), {QStringLiteral(".stg")}));
+    r.insert(QStringLiteral("photo"), has(QStringLiteral("Orthophotos"), {QStringLiteral(".png"), QStringLiteral(".dds")}));
+    return r;
+}
