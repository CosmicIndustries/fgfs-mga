+}
+
+bool LauncherController::openPath(QString path) const
+{
+    // only folders under the user's own FlightGear and fgfs-mga folders
+    const QString clean = QDir::cleanPath(path);
+    const QString home = QDir::homePath();
+    if (!(clean.startsWith(home + QStringLiteral("/.fgfs/")) || clean.startsWith(home + QStringLiteral("/.local/share/fgfs-mga"))))
+        return false;
+    QDir().mkpath(clean);
+    return QDesktopServices::openUrl(QUrl::fromLocalFile(clean));
+}
