+QVariantMap LauncherController::airportFieldInfo() const
+{
+    QVariantMap result;
+    result.insert(QStringLiteral("valid"), false);
+    if (!m_location) return result;
+    QmlPositioned* base = m_location->baseLocation();
+    if (!base || !base->valid()) return result;
+    const FGPositionedRef positioned = base->inner();
+    if (!positioned || !FGPositioned::isAirportType(positioned.ptr())) return result;
+
+    FGAirport* apt = static_cast<FGAirport*>(positioned.ptr());
+    result.insert(QStringLiteral("valid"), true);
+    result.insert(QStringLiteral("ident"), QString::fromStdString(apt->ident()));
+    result.insert(QStringLiteral("name"), QString::fromStdString(apt->name()));
+    result.insert(QStringLiteral("elevationFt"), qRound(apt->getElevation()));
+    result.insert(QStringLiteral("latitudeDeg"), apt->geod().getLatitudeDeg());
+    result.insert(QStringLiteral("longitudeDeg"), apt->geod().getLongitudeDeg());
+    result.insert(QStringLiteral("tower"), apt->hasTower());
+
+    QStringList runways;
+    QSet<QString> seen;
+    for (unsigned int i = 0; i < apt->numRunways(); ++i) {
+        FGRunwayRef rwy = apt->getRunwayByIndex(i);
+        if (!rwy) continue;
+        const QString id = QString::fromStdString(rwy->ident());
+        if (seen.contains(id)) continue;
+        seen.insert(id);
+        QString name = id;
+        if (FGRunway* rec = rwy->reciprocalRunway()) {
+            const QString recId = QString::fromStdString(rec->ident());
+            seen.insert(recId);
+            name = id + QStringLiteral("/") + recId;
+        }
+        runways << tr("%1  %2 × %3 ft  %4").arg(name).arg(qRound(rwy->lengthFt()))
+                       .arg(qRound(rwy->widthFt())).arg(mgaSurfaceName(rwy->surface()));
+    }
+    result.insert(QStringLiteral("runways"), runways);
+
+    // every runway end with its true heading, for crosswind components
+    QVariantList ends;
+    for (unsigned int i = 0; i < apt->numRunways(); ++i) {
+        FGRunwayRef rwy = apt->getRunwayByIndex(i);
+        if (!rwy) continue;
+        QVariantMap e;
+        e.insert(QStringLiteral("ident"), QString::fromStdString(rwy->ident()));
+        e.insert(QStringLiteral("headingDeg"), rwy->headingDeg());
+        e.insert(QStringLiteral("lengthFt"), qRound(rwy->lengthFt()));
+        ends << e;
+    }
+    result.insert(QStringLiteral("runwayEnds"), ends);
+
+    QStringList comms;
+    for (const auto& c : apt->commStations()) {
+        if (!c) continue;
+        comms << QStringLiteral("%1 %2").arg(QString::fromLatin1(FGPositioned::nameForType(c->type())).toUpper(),
+                                             QString::number(c->freqMHz(), 'f', 3));
+    }
+    comms.removeDuplicates();
+    result.insert(QStringLiteral("comms"), comms);
+
+    // first frequency of each kind, for auto-tuning COM1 / COM2 from the launcher
+    QVariantMap freqs;
+    for (const auto& c : apt->commStations()) {
+        if (!c) continue;
+        const QString kind = QString::fromLatin1(FGPositioned::nameForType(c->type()));
+        if (!freqs.contains(kind))
+            freqs.insert(kind, QString::number(c->freqMHz(), 'f', 3));
+    }
+    result.insert(QStringLiteral("freqs"), freqs);
+    return result;
+}
