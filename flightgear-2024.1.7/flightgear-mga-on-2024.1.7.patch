+QString LauncherController::aircraftChecklistText() const
+{
+    if (!m_selectedAircraft.isLocalFile()) return {};
+    const QDir dir = QFileInfo(m_selectedAircraft.toLocalFile()).dir();
+    QFileInfoList files = dir.entryInfoList({QStringLiteral("*hecklist*.xml")}, QDir::Files, QDir::Name);
+    if (files.isEmpty()) {
+        const QDir sub(dir.absoluteFilePath(QStringLiteral("Checklists")));
+        files = sub.entryInfoList({QStringLiteral("*.xml")}, QDir::Files, QDir::Name);
+    }
+    QString text;
+    for (const QFileInfo& fi : files) {
+        QFile f(fi.absoluteFilePath());
+        if (!f.open(QIODevice::ReadOnly)) continue;
+        QXmlStreamReader x(&f);
+        QString name, value;
+        while (!x.atEnd()) {
+            x.readNext();
+            if (!x.isStartElement()) continue;
+            const auto tag = x.name();
+            if (tag == QLatin1String("title")) {
+                text += QStringLiteral("\n") + x.readElementText().trimmed().toUpper() + QStringLiteral("\n");
+            } else if (tag == QLatin1String("name")) {
+                name = x.readElementText().trimmed();
+            } else if (tag == QLatin1String("value")) {
+                value = x.readElementText().trimmed();
+                if (!name.isEmpty()) text += QStringLiteral("  %1 .... %2\n").arg(name, value);
+                name.clear();
+            }
+        }
+    }
+    return text.trimmed();
+}
