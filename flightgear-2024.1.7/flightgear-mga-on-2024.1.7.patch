+QVariantMap LauncherController::boardStatus() const
+{
+    QVariantMap r;
+    QFile mem(QStringLiteral("/proc/meminfo"));
+    if (mem.open(QIODevice::ReadOnly)) {
+        const QStringList lines = QString::fromLatin1(mem.readAll()).split(QLatin1Char('\n'));
+        qint64 total = 0, avail = 0, swapTotal = 0, swapFree = 0;
+        for (const QString& l : lines) {
+            const QStringList p = l.simplified().split(QLatin1Char(' '));
+            if (p.size() < 2) continue;
+            if (p[0] == QStringLiteral("MemTotal:")) total = p[1].toLongLong();
+            else if (p[0] == QStringLiteral("MemAvailable:")) avail = p[1].toLongLong();
+            else if (p[0] == QStringLiteral("SwapTotal:")) swapTotal = p[1].toLongLong();
+            else if (p[0] == QStringLiteral("SwapFree:")) swapFree = p[1].toLongLong();
+        }
+        r.insert(QStringLiteral("memTotalMB"), int(total / 1024));
+        r.insert(QStringLiteral("memAvailMB"), int(avail / 1024));
+        r.insert(QStringLiteral("swapUsedMB"), int((swapTotal - swapFree) / 1024));
+    }
+    double maxTemp = 0;
+    const QFileInfoList zones = QDir(QStringLiteral("/sys/class/thermal")).entryInfoList({QStringLiteral("thermal_zone*")}, QDir::Dirs);
+    for (const QFileInfo& z : zones) {
+        QFile t(z.absoluteFilePath() + QStringLiteral("/temp"));
+        if (t.open(QIODevice::ReadOnly)) maxTemp = qMax(maxTemp, t.readAll().trimmed().toDouble() / 1000.0);
+    }
+    r.insert(QStringLiteral("cpuTempC"), qRound(maxTemp));
+    // memory held by web browsers (the usual reason this board runs short during a flight)
+    qint64 browserKb = 0;
+    const QFileInfoList procs = QDir(QStringLiteral("/proc")).entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot);
+    for (const QFileInfo& p : procs) {
+        bool isPid = false;
+        p.fileName().toInt(&isPid);
+        if (!isPid) continue;
+        QFile comm(p.absoluteFilePath() + QStringLiteral("/comm"));
+        if (!comm.open(QIODevice::ReadOnly)) continue;
+        const QString name = QString::fromLatin1(comm.readAll()).trimmed().toLower();
+        // Chromium and Firefox families, including Firefox forks (FireDragon, LibreWolf, Floorp, Waterfox, Zen)
+        // and their content processes ("Isolated Web Co", "Web Content", "WebExtensions")
+        static const QStringList browserPrefixes = {
+            QStringLiteral("chrom"), QStringLiteral("firefox"), QStringLiteral("brave"), QStringLiteral("web content"),
+            QStringLiteral("isolated web"), QStringLiteral("webextensions"), QStringLiteral("privileged cont"),
+            QStringLiteral("rdd process"), QStringLiteral("socket process"), QStringLiteral("utility process"),
+            QStringLiteral("firedragon"), QStringLiteral("librewolf"), QStringLiteral("floorp"),
+            QStringLiteral("waterfox"), QStringLiteral("zen"), QStringLiteral("vivaldi"), QStringLiteral("opera")};
+        bool isBrowser = false;
+        for (const QString& b : browserPrefixes) {
+            if (name.startsWith(b)) { isBrowser = true; break; }
+        }
+        if (!isBrowser) continue;
+        QFile status(p.absoluteFilePath() + QStringLiteral("/status"));
+        if (!status.open(QIODevice::ReadOnly)) continue;
+        const QStringList lines = QString::fromLatin1(status.readAll()).split(QLatin1Char('\n'));
+        for (const QString& l : lines) {
+            if (l.startsWith(QStringLiteral("VmRSS:"))) {
+                browserKb += l.simplified().split(QLatin1Char(' ')).value(1).toLongLong();
+                break;
+            }
+        }
+    }
+    r.insert(QStringLiteral("browserMB"), int(browserKb / 1024));
+    return r;
+}
+
+QStringList LauncherController::lanAddresses() const
+{
+    QStringList out;
+    for (const QNetworkInterface& iface : QNetworkInterface::allInterfaces()) {
+        if (!(iface.flags() & QNetworkInterface::IsUp) || (iface.flags() & QNetworkInterface::IsLoopBack)) continue;
+        if (iface.name().startsWith(QStringLiteral("docker")) || iface.name().startsWith(QStringLiteral("veth"))) continue;
+        for (const QNetworkAddressEntry& e : iface.addressEntries()) {
+            const QHostAddress a = e.ip();
+            if (a.protocol() != QAbstractSocket::IPv4Protocol) continue;
+            const quint32 v = a.toIPv4Address();
+            const bool privateUse = (v >> 24) == 10 || (v >> 20) == ((172u << 4) | 1u) || (v >> 16) == ((192u << 8) | 168u);
+            if (privateUse) out << a.toString();
+        }
+    }
+    out.removeDuplicates();
+    return out;
+}
