index 000000000..aa390653f
--- /dev/null
+++ b/src/GUI/qml/Training.qml
@@ -0,0 +1,453 @@
+import QtQuick 2.4
+import QtQuick.Controls 2.2
+import FlightGear 1.0
+import FlightGear.Launcher 1.0
+
+FocusScope {
+    id: root
+
+    signal showSelectedLocation()
+    signal showSelectedAircraft()
+
+    property var stats: _launcher.trainingStatsModel
+    property string pendingAirport: ""
+    property string airportMessage: "Choose an airport to set the launch location."
+
+    function formatHours(hours) {
+        var totalMinutes = Math.max(0, Math.round(hours * 60))
+        return Math.floor(totalMinutes / 60) + "h " + (totalMinutes % 60) + "m"
+    }
