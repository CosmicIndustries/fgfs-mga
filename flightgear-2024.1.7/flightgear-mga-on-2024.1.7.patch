+    property var mgaScenery: ({})
+    property var mgaSetups: []
+    property bool mgaPanelOpen: true
+    property bool mgaChecklistOpen: false
+    property string mgaChecklistText: ""
+    property string mgaSetupNote: ""
+    property string mgaSceneryNote: ""
+
+    function mgaJson(v) { try { return v ? JSON.parse(v) : null; } catch (e) { return null; } }
+
+    function mgaReadLive() {
+        _config.getValueForKey("mga-live", "wb", "");
+        root.mgaLive = {
+            wb: mgaJson(_config.getValueForKey("mga-live", "wb", "")),
+            perf: mgaJson(_config.getValueForKey("mga-live", "perf", "")),
+            metar: _config.getValueForKey("mga-live", "custom-metar", ""),
+            real: _config.getValueForKey("mga-live", "real-weather", false),
+            httpd: _config.getValueForKey("mga-live", "httpd", false),
+            record: _config.getValueForKey("mga-live", "record", false)
+        };
+    }
+
+    function mgaRefreshAll() {
+        root.mgaField = _launcher.airportFieldInfo();
+        root.mgaScenery = _launcher.sceneryStatus();
+        root.mgaSetups = _launcher.mgaSetupNames();
+        root.mgaBoard = _launcher.boardStatus();
+        mgaReadLive();
+        if (root.mgaField.valid) {
+            root.mgaMetarNote = qsTr("loading the METAR…");
+            _launcher.requestLocationWeather(root.mgaField.ident, 999, 999);
+        } else {
+            root.mgaMetarNote = "";
+        }
+        _launcher.runControlsTool("check");
+    }
+
+    readonly property string mgaMetar: mgaLive.metar !== "" ? mgaLive.metar : mgaRealMetar
+    readonly property var mgaWx: MgaPreflight.parseMetar(mgaMetar)
+    readonly property var mgaDa: mgaField.valid ? MgaPreflight.densityAltitude(mgaField.elevationFt, mgaWx.tempC, mgaWx.altimInHg) : null
+    readonly property var mgaBest: {
+        var ends = mgaField.valid ? (mgaField.runwayEnds || []) : [];
+        var best = null;
+        for (var i = 0; i < ends.length; i++) {
+            var c = MgaPreflight.windComponents(mgaWx.windDir, mgaWx.windKt, ends[i].headingDeg);
+            if (!best || c.head > best.c.head) best = { e: ends[i], c: c };
+        }
+        return best;
+    }
+    readonly property var mgaWb: mgaLive.wb ? MgaPreflight.weightAndBalance(mgaLive.wb) : null
+    readonly property var mgaDist: {
+        if (!mgaLive.perf) return null;
+        var w = mgaWb && mgaWb.known ? mgaWb.gross : MgaPreflight.WARRIOR.maxGross;
+        return MgaPreflight.distances(mgaLive.perf, w, mgaDa ? mgaDa.da : 0, mgaBest ? mgaBest.c.head : 0);
+    }
+
+    function mgaClock(d) { return d ? Qt.formatTime(d, "h:mm AP") : "?"; }
+    function mgaSunText() {
+        if (!mgaField.valid) return "";
+        var now = new Date();
+        var t = MgaPreflight.sunTimes(mgaField.latitudeDeg, mgaField.longitudeDeg, now);
+        var tomorrow = MgaPreflight.sunTimes(mgaField.latitudeDeg, mgaField.longitudeDeg, new Date(now.getTime() + 86400000));
+        if (!t.sunrise || !t.sunset) return qsTr("No sunrise or sunset here today.");
+        var nightStart = new Date(t.sunset.getTime() + 3600000);
+        var nightEnd = tomorrow.sunrise ? new Date(tomorrow.sunrise.getTime() - 3600000) : null;
+        return qsTr("Sunrise %1, sunset %2. Night landings count for currency from %3 to %4 (this computer's clock).")
+               .arg(mgaClock(t.sunrise)).arg(mgaClock(t.sunset)).arg(mgaClock(nightStart)).arg(mgaClock(nightEnd));
+    }
+
+    function mgaBoardText() {
+        var b = mgaBoard;
+        if (b.memAvailMB === undefined) return "";
+        var s = qsTr("%1 GB memory free, CPU %2 °C").arg((b.memAvailMB / 1024).toFixed(1)).arg(b.cpuTempC);
+        if (b.browserMB > 300) s += qsTr(", browser using %1 GB").arg((b.browserMB / 1024).toFixed(1));
+        var warn = [];
+        if (b.memAvailMB < 2500) warn.push(qsTr("low on memory, fewer browser tabs would help"));
+        if (b.cpuTempC > 75) warn.push(qsTr("running hot, the heat cap may slow frames"));
+        return s + (warn.length ? " · " + warn.join(", ") : "");
+    }
+
+    function mgaWeatherSource() {
+        if (mgaLive.metar !== "") return qsTr("your Environment choices");
+        if (mgaLive.real) return qsTr("real-world weather");
