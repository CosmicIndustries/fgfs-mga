+    // MGA: "Before you fly" panel. Board, sticks, weather, density altitude, runway wind, weight and balance,
+    // takeoff and landing estimates, daylight, scenery, instructor panel, checklist and saved setups.
+    property var mgaField: ({ valid: false })
+    property string mgaRealMetar: ""
+    property string mgaMetarNote: ""
+    property string mgaSticks: qsTr("checking…")
