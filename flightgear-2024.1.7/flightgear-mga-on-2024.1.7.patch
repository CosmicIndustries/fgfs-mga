+// MGA: Location overlay (map tiles + field info).
+
+static QString mgaSurfaceName(int code)
+{
+    switch (code) {
+    case 1: return QObject::tr("asphalt");
+    case 2: return QObject::tr("concrete");
+    case 3: return QObject::tr("turf");
+    case 4: return QObject::tr("dirt");
+    case 5: return QObject::tr("gravel");
+    case 12: return QObject::tr("dry lakebed");
+    case 13: return QObject::tr("water");
+    case 14: return QObject::tr("snow/ice");
+    default: return QObject::tr("other");
+    }
+}
